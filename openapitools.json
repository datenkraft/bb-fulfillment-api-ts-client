{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "6.4.0",
    "generators": {
      "bb-fulfillment-api": {
        "generatorName": "typescript-axios",
        "output": "src/Generated",
        "glob": "./openapi.json",
        "additionalProperties": {
          "supportsES6": true,
          "withInterfaces": true,
          "withNodeImports": true,
          "modelPackage": "models",
          "apiPackage": "apis",
          "withSeparateModelsAndApi": true
        }
      }
    }
  }
}
